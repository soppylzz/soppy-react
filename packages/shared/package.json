{
  "name": "@soppy-react/shared",
  "version": "0.0.0",
  "description": "Shared utilities for the Soppy React implementation.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soppylzz/soppy-react.git",
    "directory": "packages/shared"
  },
  "author": "soppylzz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
